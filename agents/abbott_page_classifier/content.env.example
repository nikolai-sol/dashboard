# Owner-reviewed absolute Python 3.11 executable; no PATH fallback is allowed.
ABBOTT_CONTENT_PYTHON311_BIN=/absolute/reviewed/path/to/python3.11

# Proposal/reconciliation/approval workflow role.
ABBOTT_CONTENT_WORKFLOW_DB_HOST=
ABBOTT_CONTENT_WORKFLOW_DB_PORT=3306
ABBOTT_CONTENT_WORKFLOW_DB_NAME=report_bd
ABBOTT_CONTENT_WORKFLOW_DB_USER=
ABBOTT_CONTENT_WORKFLOW_DB_PASSWORD=

# Candidate materializer and validation-gate read role.
ABBOTT_CONTENT_MATERIALIZER_DB_HOST=
ABBOTT_CONTENT_MATERIALIZER_DB_PORT=3306
ABBOTT_CONTENT_MATERIALIZER_DB_NAME=report_bd
ABBOTT_CONTENT_MATERIALIZER_DB_USER=
ABBOTT_CONTENT_MATERIALIZER_DB_PASSWORD=

# Existing release operator role: validation evidence/status transition only.
ABBOTT_RELEASE_DB_HOST=
ABBOTT_RELEASE_DB_PORT=3306
ABBOTT_RELEASE_DB_NAME=report_bd
ABBOTT_RELEASE_DB_USER=
ABBOTT_RELEASE_DB_PASSWORD=
ABBOTT_CONTENT_VALIDATION_REVIEWED_BY=

# Separately managed projection/model configuration.
ABBOTT_CONTENT_APPROVAL_SPREADSHEET_ID=
