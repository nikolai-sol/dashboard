{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "../..",
    "paths": {
      "@/*": ["src/*"],
      "@abbott/*": ["apps/abbott/src/*"],
      "@runtime-contract": ["packages/runtime-contract/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next-abbott/types/**/*.ts",
    ".next-abbott/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
